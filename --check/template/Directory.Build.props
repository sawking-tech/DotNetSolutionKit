<Project>
  <!-- Part of DotNetSolutionKit (https://dotskit.sawking.tech/). MIT License, Copyright (c) 2025 Vladimir Savkin. -->
  <!--
    The version of every assembly under src/ comes from version.json next to this file.
    To release a new version, edit "version" there and add an entry under "releaseNotes".

    The short git SHA is recorded separately, as AssemblyMetadata "GitCommit", so the version
    stays exactly what version.json says and /healthz reports the commit in its own field.
    Where there is no .git folder, as in a Docker build context, pass GIT_SHA to the
    running container instead.
  -->
  <PropertyGroup>
    <!-- The version of DotNetSolutionKit the solution was generated from, written when the template is packed;
         "source" when it was installed from the template's sources. What changed since: the template's
         release notes after this version, and its sources at the tag v<version>. -->
    <DotNetSolutionKitVersion>DOTNETSOLUTIONKIT_TEMPLATE_VERSION</DotNetSolutionKitVersion>
    <VersionJsonPath>$(MSBuildThisFileDirectory)version.json</VersionJsonPath>
    <_VersionJsonContent>$([System.IO.File]::ReadAllText('$(VersionJsonPath)'))</_VersionJsonContent>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(_VersionJsonContent), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
    <!-- The SDK appends the commit to the informational version on its own; the commit has its own field. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- A project sees only the projects it references itself, so a layer cannot reach another one by accident. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <!-- Web projects carry version.json next to their binaries, where VersionInfo reads it at runtime. -->
  <ItemGroup Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true'">
    <None Include="$(VersionJsonPath)" Link="version.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- A service generated by another major version of the template than the solution's does not build: its
       code expects the Common of its own major, and the mismatch would surface as errors far from their cause.
       A service states its version as DotNetSolutionKitServiceVersion; "source" on either side is not checked,
       and a solution generated before the version was recorded counts as 2.x. -->
  <Target Name="CheckTemplateMajor" BeforeTargets="BeforeBuild"
          Condition="'$(DotNetSolutionKitServiceVersion)' != '' AND '$(DotNetSolutionKitServiceVersion)' != 'source' AND '$(DotNetSolutionKitVersion)' != 'source'">
    <PropertyGroup>
      <_SolutionTemplateVersion>$(DotNetSolutionKitVersion)</_SolutionTemplateVersion>
      <_SolutionTemplateVersion Condition="'$(_SolutionTemplateVersion)' == ''">2.x</_SolutionTemplateVersion>
      <_SolutionTemplateMajor>$(_SolutionTemplateVersion.Split('.')[0])</_SolutionTemplateMajor>
      <_ServiceTemplateMajor>$(DotNetSolutionKitServiceVersion.Split('.')[0])</_ServiceTemplateMajor>
    </PropertyGroup>
    <Error Condition="'$(_SolutionTemplateMajor)' != '$(_ServiceTemplateMajor)'"
           Text="$(MSBuildProjectName) was generated by DotNetSolutionKit $(DotNetSolutionKitServiceVersion), the solution by $(_SolutionTemplateVersion): a service and the solution's Common need the same major version. Update the solution first, see https://dotskit.sawking.tech/docs.html#upgrading" />
  </Target>

  <Target Name="AddGitCommitMetadata" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse --short=7 HEAD"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <ItemGroup Condition="'$(_GitExitCode)' == '0' AND '$(_GitShortSha)' != ''">
      <AssemblyMetadata Include="GitCommit" Value="$(_GitShortSha)" />
    </ItemGroup>
  </Target>
</Project>
