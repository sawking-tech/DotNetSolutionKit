<Project Sdk="Microsoft.NET.Sdk">

    <!-- The secret stores of the flags Infisical and Vault: the configuration providers that overlay
         a service's configuration with the shared and its own folder or path, behind ISecretStore.
         A service with a flag references it, so only that service carries the store's SDK. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <!--#if (Infisical) -->
        <PackageReference Include="Infisical.Sdk" />
        <!--#endif -->
        <!--#if (Vault) -->
        <PackageReference Include="VaultSharp" />
        <!--#endif -->
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\common\NamespaceRoot.ProductName.Common\NamespaceRoot.ProductName.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>NamespaceRoot.ProductName.Capabilities.Security.CredentialStore.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
