<Project Sdk="Microsoft.NET.Sdk">

    <!-- The contracts of the persistence capability: IMigrationLock, IOutboxStatsDialect,
         IShortIdGenerator and MigrationLockKey. No external packages: a consumer references
         this project and gets no database driver transitively. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
</Project>
