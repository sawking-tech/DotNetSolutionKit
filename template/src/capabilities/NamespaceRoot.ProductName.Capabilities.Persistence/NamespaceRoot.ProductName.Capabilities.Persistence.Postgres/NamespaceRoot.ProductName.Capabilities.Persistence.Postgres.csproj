<Project Sdk="Microsoft.NET.Sdk">

    <!-- PostgreSQL, the solution's main database: the errors, the migration lock, the schema guard,
         the short-id sequence, the case-insensitive search and the outbox statistics dialect.
         A generated solution with Database=postgres references it from Common.Infrastructure,
         so only that composition carries the Npgsql provider. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\common\NamespaceRoot.ProductName.Common\NamespaceRoot.ProductName.Common.csproj" />
        <ProjectReference Include="..\..\..\capabilities\NamespaceRoot.ProductName.Capabilities.Persistence\NamespaceRoot.ProductName.Capabilities.Persistence.Abstractions\NamespaceRoot.ProductName.Capabilities.Persistence.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>NamespaceRoot.ProductName.Capabilities.Persistence.Postgres.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
