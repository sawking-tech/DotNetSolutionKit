<Project Sdk="Microsoft.NET.Sdk">

    <!-- Background jobs on Hangfire: the storage in the service's own schema, the dashboard and the
         filters that carry the actor and the domain-event scope into a job. A service generated with
         the Hangfire flag references it; without the flag it carries neither the project nor a job
         package. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Hangfire.AspNetCore" />
        <!--#if (Database == "mssql") -->
        <PackageReference Include="Hangfire.SqlServer" />
        <!--#else -->
        <PackageReference Include="Hangfire.PostgreSql" />
        <!--#endif -->
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\common\NamespaceRoot.ProductName.Common\NamespaceRoot.ProductName.Common.csproj" />
        <ProjectReference Include="..\..\..\common\NamespaceRoot.ProductName.Common.Application\NamespaceRoot.ProductName.Common.Application.csproj" />
        <ProjectReference Include="..\..\..\common\NamespaceRoot.ProductName.Common.Contracts\NamespaceRoot.ProductName.Common.Contracts.csproj" />
        <ProjectReference Include="..\..\..\common\NamespaceRoot.ProductName.Common.Infrastructure\NamespaceRoot.ProductName.Common.Infrastructure.csproj" />
        <ProjectReference Include="..\..\NamespaceRoot.ProductName.Capabilities.Persistence\NamespaceRoot.ProductName.Capabilities.Persistence.Abstractions\NamespaceRoot.ProductName.Capabilities.Persistence.Abstractions.csproj" />
        <!--#if (Database == "mssql") -->
        <ProjectReference Include="..\..\NamespaceRoot.ProductName.Capabilities.Persistence\NamespaceRoot.ProductName.Capabilities.Persistence.Mssql\NamespaceRoot.ProductName.Capabilities.Persistence.Mssql.csproj" />
        <!--#endif -->
        <ProjectReference Include="..\..\..\framework\NamespaceRoot.ProductName.Framework.Observability\NamespaceRoot.ProductName.Framework.Observability.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>NamespaceRoot.ProductName.Capabilities.Background.Hangfire.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
