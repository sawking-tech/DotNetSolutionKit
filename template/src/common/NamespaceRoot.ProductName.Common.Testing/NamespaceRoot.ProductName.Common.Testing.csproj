<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The categories a test declares and the Shouldly import every test project takes from here. The
      portable harness (execution contexts, the real-database test servers, stubs, rules) lives in
      NamespaceRoot.ProductName.Framework.Testing, referenced below; the audit verifiers live in
      Framework.Audit. No test framework here; a test project adds its own and tells TestSkip how that
      framework skips a test.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
        <!-- The remaining types keep the namespaces they had in Common.Tests, so tests written against them still build. -->
        <RootNamespace>NamespaceRoot.ProductName.Common.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Test libraries only: this project is referenced from test projects, and a test library that flows
             further would put Shouldly, DiffEngine and EmptyFiles into a service's output. -->
        <PackageReference Include="Moq" PrivateAssets="all" />
        <PackageReference Include="Shouldly" PrivateAssets="all" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" PrivateAssets="all" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\NamespaceRoot.ProductName.Common\NamespaceRoot.ProductName.Common.csproj" />
      <ProjectReference Include="..\NamespaceRoot.ProductName.Common.Application\NamespaceRoot.ProductName.Common.Application.csproj" />
      <ProjectReference Include="..\NamespaceRoot.ProductName.Common.Infrastructure\NamespaceRoot.ProductName.Common.Infrastructure.csproj" />
      <ProjectReference Include="..\NamespaceRoot.ProductName.Common.Contracts\NamespaceRoot.ProductName.Common.Contracts.csproj" />
      <ProjectReference Include="..\NamespaceRoot.ProductName.Common.Web\NamespaceRoot.ProductName.Common.Web.csproj" />
      <ProjectReference Include="..\..\framework\NamespaceRoot.ProductName.Framework.Testing\NamespaceRoot.ProductName.Framework.Testing.csproj" />
    </ItemGroup>

</Project>
