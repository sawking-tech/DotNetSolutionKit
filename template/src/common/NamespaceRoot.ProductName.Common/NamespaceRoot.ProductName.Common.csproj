<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="JetBrains.Annotations" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="LinqSpecs" />
    </ItemGroup>

    <!--#if (FeatureFlags) -->
    <ItemGroup>
      <!-- Travels with a ProjectReference, so every service that depends on Common gets the same file in
           its output and reads the same flags. That is what makes a feature mean one thing platform-wide
           instead of one thing per service. -->
      <Content Include="FeatureManagement/features.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>features.json</TargetPath>
      </Content>
    </ItemGroup>
    <!--#endif -->
</Project>
