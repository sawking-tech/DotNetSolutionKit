<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The portable testing harness: execution contexts (TestExecutionContext and its ladder up to
      InMemoryTestExecutionContext), the domain event test wiring, stubs for the ports that leave a
      service and the code rules. Helpers tied to an external system (the PostgreSQL and SQL Server
      test databases and the audit verifiers) stay in Common.Testing; see
      template/src/framework/README.md.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\common\NamespaceRoot.ProductName.Common\NamespaceRoot.ProductName.Common.csproj" />
        <ProjectReference Include="..\..\common\NamespaceRoot.ProductName.Common.Application\NamespaceRoot.ProductName.Common.Application.csproj" />
        <ProjectReference Include="..\..\common\NamespaceRoot.ProductName.Common.Infrastructure\NamespaceRoot.ProductName.Common.Infrastructure.csproj" />
        <!--#if (Database != "mssql") -->
        <ProjectReference Include="..\..\capabilities\NamespaceRoot.ProductName.Capabilities.Persistence\NamespaceRoot.ProductName.Capabilities.Persistence.Postgres\NamespaceRoot.ProductName.Capabilities.Persistence.Postgres.csproj" />
        <!--#endif -->
        <!--#if (Database == "mssql") -->
        <ProjectReference Include="..\..\capabilities\NamespaceRoot.ProductName.Capabilities.Persistence\NamespaceRoot.ProductName.Capabilities.Persistence.Mssql\NamespaceRoot.ProductName.Capabilities.Persistence.Mssql.csproj" />
        <!--#endif -->
        <ProjectReference Include="..\NamespaceRoot.ProductName.Framework.DomainEvents\NamespaceRoot.ProductName.Framework.DomainEvents.csproj" />
    </ItemGroup>

</Project>
