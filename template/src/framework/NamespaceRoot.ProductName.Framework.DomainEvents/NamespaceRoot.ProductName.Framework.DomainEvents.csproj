<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The domain event seam: the event handler interfaces of the three phases, the dispatcher and the
      event storage interface. The EF Core pipeline that dispatches the phases (the interceptors and
      the scope context) stays in Common.Infrastructure, as do the domain event primitives
      (IDomainEvent, IHasDomainEvents, EventfulEntity, AggregateRoot), which are tied to the core
      execution context; see the Readme and template/src/framework/README.md.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\common\NamespaceRoot.ProductName.Common\NamespaceRoot.ProductName.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    </ItemGroup>

</Project>
