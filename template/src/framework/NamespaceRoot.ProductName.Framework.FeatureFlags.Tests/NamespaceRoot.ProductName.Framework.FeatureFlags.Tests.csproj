<Project Sdk="Microsoft.NET.Sdk">

    <!-- The tests of the FeatureFlags module: the catalogue over configuration, the pinning and the
         source reporting, the keys against the file, and the Swagger filters for [FeatureGate]. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" />
        <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="Moq" />
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit3TestAdapter" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Swashbuckle.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NamespaceRoot.ProductName.Framework.FeatureFlags\NamespaceRoot.ProductName.Framework.FeatureFlags.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NamespaceRoot.ProductName.Framework.FeatureFlags" />
        <Using Include="NUnit.Framework" />
        <Using Include="Shouldly" />
        <Using Include="Moq" />
    </ItemGroup>

</Project>
