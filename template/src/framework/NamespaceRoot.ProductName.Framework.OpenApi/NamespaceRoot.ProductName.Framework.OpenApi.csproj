<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The OpenAPI surface over Swashbuckle: the Swagger setup with its filters
      (authorization, permissions, versioned documents, schema values, description
      scrubbing), the schema-only mode with its dump (DiffApi), the pagination
      operation filter, and the gateway's view of the services' documents.
      See the Readme and template/src/framework/README.md.
    -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Swashbuckle.AspNetCore" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\common\NamespaceRoot.ProductName.Common\NamespaceRoot.ProductName.Common.csproj" />
        <ProjectReference Include="..\..\common\NamespaceRoot.ProductName.Common.Contracts\NamespaceRoot.ProductName.Common.Contracts.csproj" />
        <ProjectReference Include="..\..\common\NamespaceRoot.ProductName.Common.Application\NamespaceRoot.ProductName.Common.Application.csproj" />
        <ProjectReference Include="..\..\common\NamespaceRoot.ProductName.Common.Infrastructure\NamespaceRoot.ProductName.Common.Infrastructure.csproj" />
        <ProjectReference Include="..\NamespaceRoot.ProductName.Framework.Auth\NamespaceRoot.ProductName.Framework.Auth.csproj" />
    </ItemGroup>

    <!--#if (FeatureFlags) -->
    <ItemGroup>
        <ProjectReference Include="..\NamespaceRoot.ProductName.Framework.FeatureFlags\NamespaceRoot.ProductName.Framework.FeatureFlags.csproj" />
    </ItemGroup>
    <!--#endif -->

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>NamespaceRoot.ProductName.Framework.OpenApi.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
